extends static.pug

block centerContent
    h1.pageTitle Edit Your Comment
    .formdiv
        form#editComment.formCard
            input(type="hidden" id="commentId" name="commentId" value=comment.comment_id)
            input(type="hidden" id="postId" name="postId" value=comment.post_id)

            label.label(for='content') New Comment:
            textarea(name="content" id="content") #{comment.comment}

            button#submitButton.btn.btnPrimary(type='submit') Edit Comment
    script(src='/js/editComment.js' defer='')
