extends static.pug

block centerContent
    include mixins/postCard.pug
    .browse
        if(page >= 2)
            a#prevOn(href=`/all/${page-1}`) Previous
        else 
            a#prevOff Previous
        h1.pageTitle All Blogs
        if(posts.length == 5)   
            a#nextOn(href=`/all/${page+1}`) Next
        else 
            a#nextOff Next
    .posts
        each post in posts
            +postCard(post)
        else
            p.empty No posts on this page.
