app.get("/makeMeAdmin", async(req, res) => {
  if(!req.session.userId){
    return res.status(404).render("404.pug", {user:null});
  }
  const id = req.session.userId;
  await dataMethods.makeAdmin(id);
  req.session.admin = true;

  const user =  {
    username: req.session.username,
    admin: req.session.admin
  };

  res.status(200).render("admin.pug", {user});
});


//All the POST's

app.post("/newPost", async (req, res) => {
  
  const data = req.body;

  if(!data || JSON.stringify(data) === "{}"){
    res.status(400).json({
      "status" : "error",
      "errors": ["Empty Body"]
    });
    return;
  }

  const title = data.title === "" ? -1 : data.title;
  const category = data.category === "" ? -1 : data.category;
  const content = data.content === "" ? -1 : data.content;

  if(title === -1 || title.length > 75){
    res.status(400).json({
      "status" : "error",
      "errors": ["Bad Title"]
    });
    return;
  }

  if(category === -1 || !(categories.includes(category))){
    res.status(400).json({
      "status" : "error",
      "errors": ["Bad Category"]
    });
    return;
  }

  if(content === -1){
    res.status(400).json({
      "status" : "error",
      "errors": ["Bad Content"]
    });
    return;
  }

  const temp = {
    title: title,
    category: category,
    content: content,
    user: req.session.username
  };

  await dataMethods.addPost(temp);

  return res.status(200).send("OK");
});

app.post("/newComment", async (req, res) => {
  const data = req.body;

  if(!data || JSON.stringify(data) === "{}"){
    res.status(400).json({
      "status" : "error",
      "errors": ["Empty Body"]
    });
    return;
  }

  const name = data.name ?? -1;
  const content = data.content ?? -1;
  const postId = data.postId ?? -1;

  if(name === -1 || name.length > 30){
    res.status(400).json({
      "status" : "error",
      "errors": ["Bad Name"]
    });
    return;
  }

  if(content === -1){
    res.status(400).json({
      "status" : "error",
      "errors": ["Bad Content"]
    });
    return;
  }

  if(postId === -1){
    res.status(400).json({
      "status" : "error",
      "errors": ["Bad PostId"]
    });
    return;
  }

  const temp = {
    name: name,
    content: content,
    postId: postId
  };

  await dataMethods.addComment(temp);

  return res.status(200).send("OK");

});

app.post("/login", async (req, res) => {
  const data = req.body;

  const username = data.username === "" ? -1 : data.username;
  const password = data.password === "" ? -1 : data.password;

  if(username == -1 || password == -1){
    return res.redirect(`/login?error=${encodeURIComponent("Something Went Wrong Please Try Again.")}`);
  }


  var result = await dataMethods.getPassByUN(username);

  if(result === -1){
    return res.redirect(`/login?error=${encodeURIComponent("Username Or Password Incorrect.")}`);
  }

  if(bcrypt.compareSync(password, result.password)){
    req.session.userId = result.user_id;
    req.session.username = result.username;
    req.session.admin = result.admin;
  }
  else{
    return res.redirect(`/login?error=${encodeURIComponent("Username Or Password Incorrect.")}`);
  }

  return res.redirect("/all/1");
});

app.post("/register", async (req, res) => {
  const data = req.body;

  const username = data.username === "" ? -1 : data.username;
  const password = data.password === "" ? -1 : data.password;

  if(username == -1 || password == -1){
    return res.redirect(`/register?error=${encodeURIComponent("Something Went Wrong Please Try Again.")}`);
  }
  if(username.length > 20){
    return res.redirect(`/register?error=${encodeURIComponent("Username Too Long. Must Be 20 Characters Or Less")}`);
  }

  const hashedPW = await bcrypt.hashSync(password, 10);

  try{
    var result = await dataMethods.addNewUser(username, hashedPW);
  }
  catch(err){
    return res.redirect(`/register?error=${encodeURIComponent("Username Already Exists. Please Try Again.")}`);
  }

  req.session.userId = result.insertId;
  req.session.username = username;
  req.session.admin = false;

  return res.redirect("/all/1");
});

app.post("/logout", (req, res) => {
  req.session.destroy(() => {
    return res.redirect("/all/1");
  });

});


//All the PUT's

app.put("/editPost", async (req, res) => {
  const data = req.body;

  if(!data || JSON.stringify(data) === "{}"){
    res.status(400).json({
      "status" : "error",
      "errors": ["Empty Body"]
    });
    return;
  }

  const post = await dataMethods.getPostById(data.id);

  const title = data.title === "" ? post.title : data.title;
  const category = data.category === "" ? post.category : data.category;
  const content = data.content === "" ? post.content : data.content;

  const temp = {
    title: title,
    category: category,
    content: content,
    id: data.id
  };

  await dataMethods.editPost(temp);

  return res.status(200).send("OK");
});

app.put("/editComment", async (req, res) => {
  const data = req.body;

  if(!data || JSON.stringify(data) === "{}"){
    res.status(400).json({
      "status" : "error",
      "errors": ["Empty Body"]
    });
    return;
  }

  const comment = await dataMethods.getCommentById(data.commentId);

  const content = data.content === "" ? comment.comment : data.content;

  const temp = {
    content: content,
    id: data.commentId
  };

  await dataMethods.editComment(temp);

  return res.status(200).send("OK");

});


//All the DELETE's

app.delete("/deletePost/:id", async (req, res) => {
  const id = req.params.id
  const deleted = await dataMethods.deletePost(id);
  if(deleted === 0){
    return res.status(404).send("Not Found");
  }
    return res.status(200).send("OK")
});

app.delete("/deleteComment/:id", async (req, res) => {
  const commentId = req.params.id
  const deleted = await dataMethods.deleteComment(commentId);
  if(deleted === 0){
    return res.status(404).send("Not Found");
  }
    return res.status(200).send("OK")
});


//404

app.use((req, res) => {
  const user = req.session.userId ? {
    username: req.session.username,
    admin: req.session.admin
  } : null;

  return res.status(404).render("404.pug", {user});
});

app.listen(port, () => {
  console.log(`Final Project listening on port ${port}`);
});