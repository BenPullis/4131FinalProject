const express = require('express')
const session = require("express-session");
const bcrypt = require('bcrypt')
const dataMethods = require("./data.js");
// const cookieParser = require('cookie-parser');
const app = express()
const port = process.env.PORT || 4131

const categories= ["Twins", "Vikings", "Wild", "Timberwolves"];



//Middlewear

app.use(express.static('resources'));
app.use(express.urlencoded({ extended: false }));
app.use(express.json());

app.use(session({
  secret: process.env.SESSION_SECRET,
  resave: false,
  saveUninitialized: false,
  cookie: {
    httpOnly: true,
    secure: false,
  }
}));

app.use((req, res, next) => {
  res.locals.user = req.session.user;
  next();
});


app.set("views", "templates");
app.set("view engine", "pug");

// app.use(cookieParser());

function myMiddlewear(req, res, next) {
  res.on("finish", () =>{
    console.log("Method: " + req["method"] + "      Url: " + req["url"] + "     Status Code: " + res.statusCode );
  });

  next();
}

app.use(myMiddlewear);


//All the GET's

app.get(["/", "/recent"], async (req, res) => {
  const user = req.session.userId ? {
    username: req.session.username,
    admin: req.session.admin
  } : null;

  const posts = await dataMethods.getRecentPosts(5);

  return res.status(200).render("recent.pug", {posts, user});
});

app.get("/all/:page", async (req, res) => {
  const user = req.session.userId ? {
    username: req.session.username,
    admin: req.session.admin
  } : null;

  const page = Number(req.params.page)

  if (!Number.isInteger(page) || page < 1) {
    return res.status(404).render("404.pug", {user});
  }

  const posts = await dataMethods.getAllPosts(page);

  return res.status(200).render("all.pug", {posts, page, user});
});

